PORT=3000
DATABASE_URL=mysql://finance_dev:CHANGE_ME@127.0.0.1:3308/finance_dev
MIGRATION_DATABASE_URL=mysql://finance_migration:CHANGE_ME@127.0.0.1:3308/finance_dev
READONLY_DATABASE_NAME=finance_dev_ro
READONLY_DATABASE_URL=mysql://finance_readonly:CHANGE_ME@127.0.0.1:3308/finance_dev_ro
# El mismo socket aplica al servidor y al migrador.
# DATABASE_SOCKET=/ruta/absoluta/a/mysql.sock
# APP_VERSION=0.0.0
# WEB_DIST_DIR=/ruta/absoluta/al/build/web

# Topes contables por usuario.
# MAX_ACCOUNTS_PER_USER=500
# MAX_TAGS_PER_USER=500
# MAX_TRANSACTIONS_PER_USER_PER_DAY=2000

# Autenticación MCP. En producción, define PUBLIC_URL con HTTPS.
# PUBLIC_URL=https://finanzas.example
# TOTP_ENCRYPTION_KEY debe contener 32 bytes aleatorios codificados en base64.
# TOTP_ENCRYPTION_KEY=
# Usa loopback solo detrás de Apache/Passenger local. Por defecto: off.
# TRUST_PROXY=passenger
# OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback

# Solo para los scripts de MariaDB local.
MARIADB_HOME="C:/ruta/mariadb-10.6.28-winx64"
MARIADB_DATA_DIR="C:/ruta/finance-manager-data"
MARIADB_SHUTDOWN_URL=mysql://finance_shutdown:CHANGE_ME@127.0.0.1:3308
# Define MARIADB_ADMIN_URL solo en la sesión que ejecuta db:setup.
